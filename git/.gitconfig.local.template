# Copy this to ~/.gitconfig.local and fill in your details.
# This file is NOT committed — it stays local to each machine.

[user]
  name = Your Name
  email = you@example.com
  # signingkey = YOUR_GPG_OR_SSH_KEY_ID

# Uncomment to sign commits with SSH key:
# [gpg]
#   format = ssh
# [commit]
#   gpgsign = true

# If you have an SSH key configured for GitHub, uncomment to rewrite HTTPS → SSH:
# [url "git@github.com:"]
#   insteadOf = https://github.com/

# Work-specific config — override for repos under ~/work/
# [includeIf "gitdir:~/work/"]
#   path = ~/.gitconfig.work
